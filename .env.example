# VEXA - Variables de entorno (copiar a .env y completar)

# Supabase principal
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PROJECT_ID=

# Supabase externo (n8n_chat_histories, realtime)
NEXT_PUBLIC_EXTERNAL_SUPABASE_URL=
NEXT_PUBLIC_EXTERNAL_SUPABASE_ANON_KEY=

# n8n (opcionales: si se dejan vacías se usan los valores por defecto del código)
NEXT_PUBLIC_N8N_BASE_URL=
NEXT_PUBLIC_N8N_WEBHOOK_AGENT=
NEXT_PUBLIC_N8N_WEBHOOK_SETTINGS=
NEXT_PUBLIC_N8N_WEBHOOK_HUMAN_MESSAGE=
